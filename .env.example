# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
OWNER_TELEGRAM_ID=             # your numeric Telegram id (from @userinfobot); only you can use the bot

# --- Moodle (elearning.gtu.ge) ---
MOODLE_URL=https://elearning.gtu.ge
MOODLE_TOKEN=                  # Profile > Preferences > Security keys > Moodle mobile web service
MOODLE_FINALIZE=false          # true = also press "Submit assignment" after saving

# --- Claude (only latexwork needs it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Drive (info-security assignments) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=          # created once by: python scripts/google_auth.py
DRIVE_ROOT_FOLDER_ID=          # id of the Drive folder that holds the "დავალება N" folders (from its URL)
DRIVE_STUDENT_FOLDER=          # your subfolder name inside each assignment folder; empty = STUDENT_GROUP

# --- misc ---
# --- personal data (printed in the document header; keep it out of git) ---
STUDENT_NAME=                  # e.g. "<first name> <last name>"
STUDENT_GROUP=                 # e.g. "<group number>"

# --- look of the generated terminal screenshots (cppwork) ---
SHOT_PROMPT=user@computer cpp %
SHOT_BIN_DIR=/home/user/cpp
BOT_MODE=polling               # polling | webhook
WEBHOOK_URL=                   # https://your-host (webhook mode)
